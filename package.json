{
  "name": "cognitive-learn-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "test": "node tests/academic.test.cjs && node tests/cognitive-observation.test.cjs && node tests/admin-deeplink.test.cjs",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:rules": "node --test tests/firestore.rules.cp21.test.mjs",
    "test:rules:emulator": "firebase emulators:exec --project demo-cla-cp21-security --config firebase.emulator.cp21.json --only firestore \"npm run test:rules\"",
    "test:rules:static": "node --test tests/cp21.rules.contract.test.cjs",
    "check:layout": "node tools/check-cla-layout.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "^17.4.2",
    "firebase": "^12.14.0",
    "lucide-react": "^1.17.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "^22.16.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
