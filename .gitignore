# Credentials and local environments
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*service-account*.json

# Build outputs and tooling state
node_modules/
dist/
.vercel/
.firebase/
*.tsbuildinfo
coverage/
.DS_Store

# Research data must remain private and approved
research/data/raw_private/
research/data/processed_private/
research/data/staging_private/
research/data/splits_private/
research/evidence/private/
research/reports/private/
reports/security/*.log
reports/security/*.json

# Python-generated artifacts
__pycache__/
*.pyc

# Local emulator diagnostics
firestore-debug.log
firebase-debug.log
ui-debug.log
java_pid*.hprof
hs_err_pid*.log

# Optional Web Push deployment credentials and local runtime state
functions/.env
functions/.env.*
!functions/.env.example
functions/node_modules/
functions/.runtimeconfig.json

# External Hugging Face datasets and predictions must not be committed
research/huggingface/**/work/
research/huggingface/**/.venv/

# Real OULAD research data and derivatives — never commit or publish
research/oulad/data/
research/oulad/work/

# Optional dedicated privacy-cleanup Functions deployment
functions-privacy/.env
functions-privacy/.env.*
!functions-privacy/.env.example
functions-privacy/node_modules/
functions-privacy/.runtimeconfig.json

# Dedicated privileged admin callable configuration (local secrets never bundled)
functions-admin/.env
functions-admin/.env.*
!functions-admin/.env.example
functions-admin/node_modules/
functions-admin/.runtimeconfig.json

# QA browser reports contain local run metadata and must not be shipped
reports/e2e/
