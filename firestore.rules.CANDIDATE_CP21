rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function activeRole(role) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true
        && get(userPath(request.auth.uid)).data.role == role;
    }

    function studentOwns(uid) {
      return signedIn() && request.auth.uid == uid && activeRole('student');
    }

    // Product consent is a prerequisite to creating/changing student data.
    // It is not consent to research and does not verify a guardian's identity.
    function consentPath(uid) {
      return /databases/$(database)/documents/student_consents/$(uid);
    }

    function hasProductConsent(uid) {
      return exists(consentPath(uid))
        && get(consentPath(uid)).data.productAccepted == true
        && get(consentPath(uid)).data.noticeVersion == 'cla-student-privacy-v1';
    }

    function studentMayPersist(uid) {
      return studentOwns(uid) && hasProductConsent(uid);
    }

    function academicMayPersist(uid) {
      return studentMayPersist(uid) || adminOwnsDemo(uid);
    }

    function validStudentConsent(uid) {
      let data = request.resource.data;
      return studentOwns(uid)
        && data.keys().hasOnly(['userId', 'schemaVersion', 'noticeVersion', 'productAccepted', 'researchConsent', 'updatedAt'])
        && data.keys().hasAll(['userId', 'schemaVersion', 'noticeVersion', 'productAccepted', 'researchConsent', 'updatedAt'])
        && data.userId == uid
        && data.schemaVersion == 1
        && data.noticeVersion == 'cla-student-privacy-v1'
        && data.productAccepted is bool
        // Research participation remains disabled until guardian/ethics workflow exists.
        && data.researchConsent == false
        && data.updatedAt == request.time;
    }

    match /student_consents/{uid} {
      allow get: if studentOwns(uid);
      allow list: if false;
      allow create, update: if validStudentConsent(uid);
      allow delete: if false;
    }

    function adminOwnsDemo(uid) {
      return signedIn() && request.auth.uid == uid && activeRole('admin');
    }

    function selfAcademicOwner(uid) {
      return studentOwns(uid) || adminOwnsDemo(uid);
    }

    function activeSelf() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true;
    }

    function validUserCreate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly(['email', 'role', 'fullName', 'active', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'role', 'fullName', 'active', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role in ['student', 'teacher', 'parent']
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.active == true
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 64;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if validUserCreate(uid);
      allow update, delete: if false;
    }

    function validDataScope(uid, data) {
      return data.get('dataScope', '') == (adminOwnsDemo(uid) ? 'demo' : 'student');
    }

    function validElectiveSubjects(selected) {
      return selected is list
        && selected.size() == 4
        && selected.hasOnly([
          'Vật lý', 'Hóa học', 'Sinh học', 'Địa lý',
          'Giáo dục kinh tế và pháp luật', 'Tin học', 'Công nghệ',
          'Âm nhạc', 'Mĩ thuật'])
        && selected[0] != selected[1]
        && selected[0] != selected[2]
        && selected[0] != selected[3]
        && selected[1] != selected[2]
        && selected[1] != selected[3]
        && selected[2] != selected[3];
    }

    function validAcademicCurriculum(curriculum) {
      return curriculum is map
        && curriculum.program == 'GDPT 2018'
        && curriculum.foreignLanguage is string
        && curriculum.foreignLanguage.size() > 0
        && curriculum.foreignLanguage.size() <= 60
        && validElectiveSubjects(curriculum.selectedElectives)
        && !curriculum.selectedElectives.hasAny([curriculum.foreignLanguage])
        && curriculum.get('electiveSelectionLocked', false) == true
        && curriculum.gradedSubjects == [
          'Toán', 'Ngữ văn', curriculum.foreignLanguage, 'Lịch sử',
          'Giáo dục quốc phòng và an ninh',
          curriculum.selectedElectives[0], curriculum.selectedElectives[1],
          curriculum.selectedElectives[2], curriculum.selectedElectives[3]];
    }

    function preserveLockedElectives(previous, next) {
      return !(previous is map
          && previous.get('curriculum', {}) is map
          && previous.get('curriculum', {}).get('selectedElectives', []) is list
          && previous.get('curriculum', {}).get('selectedElectives', []).size() == 4)
        || previous.curriculum.selectedElectives == next.curriculum.selectedElectives;
    }

    function legacySelectedElectives(uid, curriculum) {
      let path = /databases/$(database)/documents/learning_profiles/$(uid);
      return !exists(path)
        || preserveLockedElectives(get(path).data, {'curriculum': curriculum});
    }

    function matchesStoredTranscript(uid, curriculum) {
      let path = /databases/$(database)/documents/student_transcripts/$(uid);
      return !exists(path)
        || get(path).data.curriculum.selectedElectives == curriculum.selectedElectives;
    }

    match /learning_profiles/{uid} {
      allow get: if selfAcademicOwner(uid);
      allow list: if false;
      allow create: if academicMayPersist(uid)
        && request.resource.data.get('schemaVersion', 0) == 1
        && validAcademicCurriculum(request.resource.data.curriculum)
        && matchesStoredTranscript(uid, request.resource.data.curriculum)
        && request.resource.data.userId == uid
        && validDataScope(uid, request.resource.data);
      allow update: if academicMayPersist(uid)
        && request.resource.data.get('schemaVersion', 0) == 1
        && validAcademicCurriculum(request.resource.data.curriculum)
        && preserveLockedElectives(resource.data, request.resource.data)
        && matchesStoredTranscript(uid, request.resource.data.curriculum)
        && request.resource.data.userId == uid
        && validDataScope(uid, request.resource.data);
      allow delete: if false;

      match /cognitive_history/{snapshotId} {
        allow get, list: if selfAcademicOwner(uid);
        allow create: if academicMayPersist(uid)
          && request.resource.data.studentId == uid
          && validDataScope(uid, request.resource.data);
        allow update, delete: if false;
      }
    }

    function validLinkId(linkId, studentId, viewerId) {
      return linkId == studentId + '_' + viewerId
        && studentId is string
        && viewerId is string
        && studentId.size() >= 6 && studentId.size() <= 128
        && viewerId.size() >= 6 && viewerId.size() <= 128
        && studentId != viewerId;
    }

    function viewerHasRole(viewerId, viewerRole) {
      return exists(userPath(viewerId))
        && get(userPath(viewerId)).data.active == true
        && get(userPath(viewerId)).data.role == viewerRole;
    }

    function linkReadAllowed(data) {

      return activeSelf()
        && (data.studentId == request.auth.uid
            || (data.viewerId == request.auth.uid && hasProductConsent(data.studentId)));
    }

    function linkPath(linkId) {
      return /databases/$(database)/documents/student_links/$(linkId);
    }

    function validLinkCreate(linkId) {
      return signedIn()
        && activeRole('student')
        && hasProductConsent(request.auth.uid)
        && request.resource.data.keys().hasOnly(['studentId', 'viewerId', 'viewerRole', 'studentName', 'createdAt'])
        && request.resource.data.keys().hasAll(['studentId', 'viewerId', 'viewerRole', 'studentName', 'createdAt'])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.viewerRole in ['teacher', 'parent']
        && validLinkId(linkId, request.resource.data.studentId, request.resource.data.viewerId)
        && viewerHasRole(request.resource.data.viewerId, request.resource.data.viewerRole)
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.createdAt == request.time;
    }

    match /student_links/{linkId} {
      allow get: if linkReadAllowed(resource.data);
      allow list: if signedIn() && request.query.limit <= 40
        && linkReadAllowed(resource.data);
      allow create: if validLinkCreate(linkId);
      allow update: if false;
      allow delete: if studentOwns(resource.data.studentId)
        && !exists(/databases/$(database)/documents/student_shared_reports/$(linkId));
    }

    function validReportLink(linkId, data) {
      return exists(linkPath(linkId))
        && get(linkPath(linkId)).data.studentId == data.studentId
        && get(linkPath(linkId)).data.viewerId == data.viewerId
        && get(linkPath(linkId)).data.viewerRole == data.viewerRole;
    }

    function allowedReportFields() {
      return ['studentId', 'viewerId', 'viewerRole', 'title', 'summary',
        'nextStep', 'status', 'feedback', 'reviewedAt', 'createdAt'];
    }

    function validReportCreate(linkId) {
      let data = request.resource.data;
      return studentMayPersist(data.studentId)
        && data.keys().hasOnly(allowedReportFields())
        && data.keys().hasAll(allowedReportFields())
        && validReportLink(linkId, data)
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 70
        && data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 900
        && data.nextStep is string && data.nextStep.size() <= 400
        && data.status == 'shared' && data.feedback == ''
        && data.reviewedAt == null
        && data.createdAt == request.time;
    }

    function canReadReport(linkId) {
      return signedIn()
        && validReportLink(linkId, resource.data)
        && (studentOwns(resource.data.studentId)
           || (hasProductConsent(resource.data.studentId) && resource.data.viewerId == request.auth.uid
               && activeRole(resource.data.viewerRole)
               && resource.data.viewerRole in ['teacher', 'parent']));
    }

    function validOneTimeReview(linkId) {
      return signedIn()
        && hasProductConsent(resource.data.studentId)
        && resource.data.status == 'shared'
        && resource.data.feedback == ''
        && resource.data.viewerId == request.auth.uid
        && resource.data.viewerRole in ['teacher', 'parent']
        && activeRole(resource.data.viewerRole)
        && validReportLink(linkId, resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['feedback', 'status', 'reviewedAt'])
        && request.resource.data.status == 'reviewed'
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() >= 5
        && request.resource.data.feedback.size() <= 600
        && request.resource.data.reviewedAt == request.time;
    }

    match /student_shared_reports/{linkId} {
      allow get: if canReadReport(linkId);
      allow list: if false;
      allow create: if validReportCreate(linkId);
      allow update: if validOneTimeReview(linkId);
      allow delete: if signedIn()
        && exists(linkPath(linkId))
        && studentOwns(get(linkPath(linkId)).data.studentId)
        && (resource == null || resource.data.studentId == request.auth.uid);
    }

    function ownerRecord(uid) {
      return academicMayPersist(uid)
        && request.resource.data.userId == uid
        && request.resource.data.schemaVersion == 1;
    }

    match /student_transcripts/{uid} {
      allow get: if selfAcademicOwner(uid);
      allow list: if false;
      allow create: if ownerRecord(uid)
        && validAcademicCurriculum(request.resource.data.curriculum)
        && legacySelectedElectives(uid, request.resource.data.curriculum)
        && validDataScope(uid, request.resource.data)
        && request.resource.data.keys().hasOnly([
          'userId', 'schemaVersion', 'dataScope', 'curriculum', 'transcript', 'gpaSummary', 'updatedAt'])
        && request.resource.data.curriculum is map
        && request.resource.data.transcript is map
        && request.resource.data.gpaSummary is map
        && request.resource.data.updatedAt == request.time;
      allow update: if ownerRecord(uid)
        && validAcademicCurriculum(request.resource.data.curriculum)
        && preserveLockedElectives(resource.data, request.resource.data)
        && legacySelectedElectives(uid, request.resource.data.curriculum)
        && validDataScope(uid, request.resource.data)
        && request.resource.data.keys().hasOnly([
          'userId', 'schemaVersion', 'dataScope', 'curriculum', 'transcript', 'gpaSummary', 'updatedAt'])
        && request.resource.data.curriculum is map
        && request.resource.data.transcript is map
        && request.resource.data.gpaSummary is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /atlas_workspaces/{uid} {
      allow get: if selfAcademicOwner(uid);
      allow list: if false;
      allow create, update: if ownerRecord(uid)
        && request.resource.data.keys().hasOnly([
          'userId', 'schemaVersion', 'universities', 'sources', 'programs', 'updatedAt'])
        && request.resource.data.universities is list
        && request.resource.data.sources is list
        && request.resource.data.programs is list
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /orion_drafts/{uid} {
      allow get: if selfAcademicOwner(uid);
      allow list: if false;
      allow create, update: if ownerRecord(uid)
        && request.resource.data.keys().hasOnly(['userId', 'schemaVersion', 'data', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /pulse_drafts/{uid} {
      allow get: if selfAcademicOwner(uid);
      allow list: if false;
      allow create, update: if ownerRecord(uid)
        && request.resource.data.keys().hasOnly(['userId', 'schemaVersion', 'data', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /haven_drafts/{uid} {
      allow get: if selfAcademicOwner(uid);
      allow list: if false;
      allow create, update: if ownerRecord(uid)
        && request.resource.data.keys().hasOnly(['userId', 'schemaVersion', 'data', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // CLA Closed-Loop v1: student-owned, self-reported cycles, not verified research outcomes.
    // Read remains available after consent withdrawal, but no new writes are allowed.
    function validJourneySubject(subject) {
      return subject is map
        && subject.keys().hasOnly(['key', 'label', 'baseline', 'target'])
        && subject.keys().hasAll(['key', 'label', 'baseline', 'target'])
        && subject.key is string && subject.key.matches('[a-z]{2,20}')
        && subject.label is string && subject.label.size() >= 1 && subject.label.size() <= 40
        && subject.baseline is number && subject.baseline >= 0 && subject.baseline <= 10
        && subject.target is number && subject.target >= 0 && subject.target <= 10;
    }
    function validJourneySubjects(subjects) {
      return subjects is list && subjects.size() >= 1 && subjects.size() <= 6
        && validJourneySubject(subjects[0])
        && (subjects.size() < 2 || validJourneySubject(subjects[1]))
        && (subjects.size() < 3 || validJourneySubject(subjects[2]))
        && (subjects.size() < 4 || validJourneySubject(subjects[3]))
        && (subjects.size() < 5 || validJourneySubject(subjects[4]))
        && (subjects.size() < 6 || validJourneySubject(subjects[5]));
    }
    function validJourneyObservation(observation) {
      return observation is map
        && observation.keys().hasOnly(['key', 'score'])
        && observation.keys().hasAll(['key', 'score'])
        && observation.key is string && observation.key.matches('[a-z]{2,20}')
        && observation.score is number && observation.score >= 0 && observation.score <= 10;
    }
    function validJourneyObservations(observations) {
      return observations is list && observations.size() >= 1 && observations.size() <= 6
        && validJourneyObservation(observations[0])
        && (observations.size() < 2 || validJourneyObservation(observations[1]))
        && (observations.size() < 3 || validJourneyObservation(observations[2]))
        && (observations.size() < 4 || validJourneyObservation(observations[3]))
        && (observations.size() < 5 || validJourneyObservation(observations[4]))
        && (observations.size() < 6 || validJourneyObservation(observations[5]));
    }
    function validJourneyCheckIn(entry, maxWeek) {
      return entry is map
        && entry.keys().hasOnly(['id', 'week', 'recordedAt', 'actualHours', 'completedActions', 'plannedActions', 'note', 'provenance'])
        && entry.keys().hasAll(['id', 'week', 'recordedAt', 'actualHours', 'completedActions', 'plannedActions', 'note', 'provenance'])
        && entry.id is string && entry.id.size() >= 8 && entry.id.size() <= 100
        && entry.week is int && entry.week >= 1 && entry.week <= maxWeek
        && entry.recordedAt is string && entry.recordedAt.size() <= 40
        && entry.actualHours is number && entry.actualHours >= 0 && entry.actualHours <= 168
        && entry.plannedActions is int && entry.plannedActions >= 1 && entry.plannedActions <= 20
        && entry.completedActions is int && entry.completedActions >= 0 && entry.completedActions <= entry.plannedActions
        && entry.note is string && entry.note.size() <= 240
        && entry.provenance == 'student_self_report';
    }

    function validJourneyReassessment(result) {
      return result is map
        && result.keys().hasOnly(['recordedAt', 'observations', 'note', 'provenance'])
        && result.keys().hasAll(['recordedAt', 'observations', 'note', 'provenance'])
        && result.recordedAt is string && result.recordedAt.size() <= 40
        && validJourneyObservations(result.observations)
        && result.note is string && result.note.size() <= 240
        && result.provenance == 'student_self_report';
    }

    // Fixed per-student mutex document. Every new ACTIVE cycle must be created
    // in the same atomic transaction/batch as the metadata transition.
    function journeyStatePath(uid) {
      return /databases/$(database)/documents/learning_journeys/$(uid)/state/current;
    }

    function journeyCyclePath(uid, cycleId) {
      return /databases/$(database)/documents/learning_journeys/$(uid)/cycles/$(cycleId);
    }

    function validJourneyState(uid) {
      let state = request.resource.data;
      return studentMayPersist(uid)
        && state.keys().hasOnly(['userId', 'schemaVersion', 'activeCycleId', 'updatedAt'])
        && state.keys().hasAll(['userId', 'schemaVersion', 'activeCycleId', 'updatedAt'])
        && state.userId == uid && state.schemaVersion == 1
        && (state.activeCycleId == null || (state.activeCycleId is string
          && state.activeCycleId.size() >= 8 && state.activeCycleId.size() <= 100))
        && state.updatedAt == request.time;
    }

    function validJourneyEvidence(record, cycleId, reassessment) {
      return record is map
        && record.keys().hasOnly(['resultId', 'resultType', 'participantPseudonym',
          'inputSnapshotId', 'engine', 'datasetVersion', 'featureVersion', 'modelVersion',
          'output', 'uncertainty', 'factors', 'evidenceRefs', 'limitations',
          'sourceVersions', 'codeCommitHash', 'createdAt', 'humanOverride'])
        && record.keys().hasAll(['resultId', 'resultType', 'participantPseudonym',
          'inputSnapshotId', 'engine', 'datasetVersion', 'featureVersion', 'modelVersion',
          'output', 'uncertainty', 'factors', 'evidenceRefs', 'limitations',
          'sourceVersions', 'codeCommitHash', 'createdAt', 'humanOverride'])
        && record.resultId == cycleId + '-review'
        && record.inputSnapshotId == cycleId
        && record.participantPseudonym == 'local-cycle-' + cycleId
        && record.resultType == 'recommendation'
        && record.engine is map && record.engine.name == 'CLA Closed-Loop Analyzer'
        && record.engine.version == '1.1.0'
        && record.datasetVersion == 'student-self-report-v1'
        && record.featureVersion == 'closed-loop-v1'
        && record.modelVersion == 'rule-based-unvalidated-v1'
        && record.output is map
        && record.output.keys().hasOnly(['value', 'probability', 'unit'])
        && record.output.keys().hasAll(['value', 'probability', 'unit'])
        && record.output.probability == null
        && (record.output.value == null || (record.output.value is number
          && record.output.value >= -10 && record.output.value <= 10))
        && record.output.unit == 'score-points-0-to-10'
        && record.uncertainty is map
        && record.uncertainty.type == 'not_estimated'
        && record.uncertainty.value == null
        && record.factors is list && record.factors.size() == 2
        && record.evidenceRefs is list && record.evidenceRefs.size() >= 2 && record.evidenceRefs.size() <= 13
        && record.limitations is list && record.limitations.size() == 3
        && record.sourceVersions is list && record.sourceVersions.size() == 1
        && record.codeCommitHash == 'not_recorded'
        && record.createdAt == reassessment.recordedAt
        && record.humanOverride == null;
    }

    match /learning_journeys/{uid}/state/{stateId} {
      allow get: if stateId == 'current' && studentOwns(uid);
      allow list: if false;
      // Create the lock atomically with the new cycle, or claim a legacy ACTIVE
      // cycle which was created before the fixed mutex existed.
      allow create: if stateId == 'current' && validJourneyState(uid)
        && request.resource.data.activeCycleId is string
        && getAfter(journeyCyclePath(uid, request.resource.data.activeCycleId)).data.status == 'ACTIVE'
        && getAfter(journeyCyclePath(uid, request.resource.data.activeCycleId)).data.userId == uid;
      allow update: if stateId == 'current' && validJourneyState(uid)
        && resource.data.userId == uid && resource.data.schemaVersion == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeCycleId', 'updatedAt'])
        && ((resource.data.activeCycleId == null
          && request.resource.data.activeCycleId is string
          && getAfter(journeyCyclePath(uid, request.resource.data.activeCycleId)).data.status == 'ACTIVE'
          && getAfter(journeyCyclePath(uid, request.resource.data.activeCycleId)).data.userId == uid)
          || (resource.data.activeCycleId is string
            && request.resource.data.activeCycleId == null
            && get(journeyCyclePath(uid, resource.data.activeCycleId)).data.status == 'ACTIVE'
            && getAfter(journeyCyclePath(uid, resource.data.activeCycleId)).data.status == 'REVIEWED'));
      allow delete: if false;
    }

    function validJourneyRecord(uid, cycleId) {
      let data = request.resource.data;
      return studentMayPersist(uid)
        && data.keys().hasOnly(['id', 'userId', 'schemaVersion', 'origin', 'scenarioId', 'scenarioTitle',
          'targetMajor', 'subjects', 'plannedWeeklyHours', 'weeksLeft', 'startedAt',
          'status', 'checkIns', 'reassessment', 'evidenceRecord', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'userId', 'schemaVersion', 'origin', 'scenarioId', 'scenarioTitle',
          'targetMajor', 'subjects', 'plannedWeeklyHours', 'weeksLeft', 'startedAt',
          'status', 'checkIns', 'reassessment', 'createdAt', 'updatedAt'])
        && cycleId.size() >= 8 && cycleId.size() <= 100
        && data.id == cycleId && data.userId == uid && data.schemaVersion == 1
        && data.origin == 'orion_simulation'
        && data.scenarioId in ['balanced', 'focused', 'breakthrough']
        && data.scenarioTitle is string && data.scenarioTitle.size() >= 1 && data.scenarioTitle.size() <= 100
        && data.targetMajor is string && data.targetMajor.size() <= 120
        && validJourneySubjects(data.subjects)
        && data.plannedWeeklyHours is int && data.plannedWeeklyHours >= 1 && data.plannedWeeklyHours <= 80
        && data.weeksLeft is int && data.weeksLeft >= 1 && data.weeksLeft <= 104
        && data.startedAt is string && data.startedAt.size() <= 40
        && data.status in ['ACTIVE', 'REVIEWED']
        && data.checkIns is list && data.checkIns.size() <= 12
        && (data.reassessment == null || validJourneyReassessment(data.reassessment))
        && (data.get('evidenceRecord', null) == null
          || (data.status == 'REVIEWED' && validJourneyEvidence(data.evidenceRecord, cycleId, data.reassessment)))
        && data.updatedAt == request.time;
    }

    match /learning_journeys/{uid}/cycles/{cycleId} {
      allow get: if studentOwns(uid);
      allow list: if studentOwns(uid) && request.query.limit != null && request.query.limit <= 8;
      allow create: if validJourneyRecord(uid, cycleId)
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.checkIns.size() == 0
        && request.resource.data.reassessment == null
        && request.resource.data.get('evidenceRecord', null) == null
        && request.resource.data.createdAt == request.time
        && (!exists(journeyStatePath(uid)) || get(journeyStatePath(uid)).data.activeCycleId == null)
        && getAfter(journeyStatePath(uid)).data.activeCycleId == cycleId;
      allow update: if validJourneyRecord(uid, cycleId)
        && resource.data.userId == uid && resource.data.schemaVersion == 1
        && resource.data.status == 'ACTIVE'
        && exists(journeyStatePath(uid))
        && get(journeyStatePath(uid)).data.activeCycleId == cycleId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'checkIns', 'reassessment', 'evidenceRecord', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.checkIns.size() >= resource.data.checkIns.size()
        && request.resource.data.checkIns.size() <= resource.data.checkIns.size() + 1
        && request.resource.data.checkIns.hasAll(resource.data.checkIns)
        && (request.resource.data.checkIns.size() == resource.data.checkIns.size()
          || validJourneyCheckIn(request.resource.data.checkIns[request.resource.data.checkIns.size() - 1], request.resource.data.weeksLeft))
        && (request.resource.data.status == 'ACTIVE'
          ? request.resource.data.reassessment == null
            && request.resource.data.get('evidenceRecord', null) == resource.data.get('evidenceRecord', null)
            && getAfter(journeyStatePath(uid)).data.activeCycleId == cycleId
          : request.resource.data.checkIns.size() >= 1
            && validJourneyReassessment(request.resource.data.reassessment)
            && validJourneyEvidence(request.resource.data.get('evidenceRecord', null), cycleId, request.resource.data.reassessment)
            && getAfter(journeyStatePath(uid)).data.activeCycleId == null);
      allow delete: if false;
    }

    match /module_drafts/{uid} {
      allow get: if selfAcademicOwner(uid);
      allow list, create, update, delete: if false;
    }

    // CP24: strictly schema-bound, append-only per-owner technical lineage.
    // No arbitrary text, UID, name, academic scores, claims or model outputs are accepted.
    function validPipelineStatus(status) {
      return status in ['MISSING', 'LIMITED', 'PRESENT', 'INVALID'];
    }

    function validPipelineEvidence(uid) {
      let data = request.resource.data;
      return academicMayPersist(uid)
        && data.keys().hasOnly([
          'schemaVersion', 'evidenceVersion', 'recordType', 'dataScope',
          'checkedAt', 'createdAt', 'complete', 'stages', 'historyStatus', 'historyCount'])
        && data.keys().hasAll([
          'schemaVersion', 'evidenceVersion', 'recordType', 'dataScope',
          'checkedAt', 'createdAt', 'complete', 'stages', 'historyStatus', 'historyCount'])
        && data.schemaVersion == 1
        && data.evidenceVersion == 'cla-pipeline-evidence-v1'
        && data.recordType == 'technical-lineage'
        && validDataScope(uid, data)
        && data.complete == false
        && data.checkedAt is string
        && data.checkedAt.size() >= 20 && data.checkedAt.size() <= 35
        && data.createdAt == request.time
        && data.stages is map
        && data.stages.keys().hasOnly(['seed','lumen','orion','pulse'])
        && data.stages.keys().hasAll(['seed','lumen','orion','pulse'])
        && validPipelineStatus(data.stages.seed)
        && validPipelineStatus(data.stages.lumen)
        && validPipelineStatus(data.stages.orion)
        && validPipelineStatus(data.stages.pulse)
        && data.historyStatus in ['NONE', 'SINGLE', 'MULTIPLE', 'INCONSISTENT']
        && data.historyCount is int
        && data.historyCount >= 0 && data.historyCount <= 10
        && (data.historyStatus != 'NONE' || data.historyCount == 0)
        && (data.historyStatus != 'SINGLE' || data.historyCount == 1)
        && (!(data.historyStatus in ['MULTIPLE','INCONSISTENT']) || data.historyCount >= 2);
    }

    match /pipeline_evidence/{uid}/checks/{checkId} {
      allow get: if selfAcademicOwner(uid);
      allow list: if selfAcademicOwner(uid) && request.query.limit != null && request.query.limit <= 20;
      allow create: if validPipelineEvidence(uid);
      allow update, delete: if false;
    }


    // Daily Companion v1: account-scoped schedule and at most 14 self-reported dates.
    // No push token, raw grades or precise location is stored here.
    function validCompanionClock(value) {
      return value is string && value.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
    }
    function validCompanionDay(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    function validCompanionDays(days) {
      return days is list && days.size() <= 14
        && (days.size() < 1 || validCompanionDay(days[0]))
        && (days.size() < 2 || validCompanionDay(days[1]))
        && (days.size() < 3 || validCompanionDay(days[2]))
        && (days.size() < 4 || validCompanionDay(days[3]))
        && (days.size() < 5 || validCompanionDay(days[4]))
        && (days.size() < 6 || validCompanionDay(days[5]))
        && (days.size() < 7 || validCompanionDay(days[6]))
        && (days.size() < 8 || validCompanionDay(days[7]))
        && (days.size() < 9 || validCompanionDay(days[8]))
        && (days.size() < 10 || validCompanionDay(days[9]))
        && (days.size() < 11 || validCompanionDay(days[10]))
        && (days.size() < 12 || validCompanionDay(days[11]))
        && (days.size() < 13 || validCompanionDay(days[12]))
        && (days.size() < 14 || validCompanionDay(days[13]));
    }
    function validDailyCompanion(uid) {
      let data = request.resource.data;
      return studentMayPersist(uid)
        && data.keys().hasOnly(['userId', 'schemaVersion', 'enabled', 'schedule',
           'quietStart', 'quietEnd', 'completedDays', 'updatedAt'])
        && data.keys().hasAll(['userId', 'schemaVersion', 'enabled', 'schedule',
           'quietStart', 'quietEnd', 'completedDays', 'updatedAt'])
        && data.userId == uid && data.schemaVersion == 1
        && data.enabled is bool
        && data.schedule is map
        && data.schedule.keys().hasOnly(['morning', 'study', 'checkIn'])
        && data.schedule.keys().hasAll(['morning', 'study', 'checkIn'])
        && validCompanionClock(data.schedule.morning)
        && validCompanionClock(data.schedule.study)
        && validCompanionClock(data.schedule.checkIn)
        && validCompanionClock(data.quietStart)
        && validCompanionClock(data.quietEnd)
        && validCompanionDays(data.completedDays)
        && data.updatedAt == request.time;
    }
    match /daily_companion/{uid} {
      allow get: if studentOwns(uid);
      allow list: if false;
      allow create, update: if validDailyCompanion(uid);
      allow delete: if false;
    }

    // Web Push is an optional, per-device transport; this is NOT the learner record.
    // Registration requires verified product consent; deletion remains available when
    // product consent is withdrawn. The scheduler re-checks consent on every tick.
    function validCompanionPushDevice(uid, deviceId) {
      let data = request.resource.data;
      return studentMayPersist(uid)
        && deviceId.matches('^[a-f0-9]{32}$')
        && data.keys().hasOnly(['userId','schemaVersion','enabled','timeZone',
           'endpoint','keys','updatedAt'])
        && data.keys().hasAll(['userId','schemaVersion','enabled','timeZone',
           'endpoint','keys','updatedAt'])
        && data.userId == uid && data.schemaVersion == 1
        && data.enabled == true
        && data.timeZone is string && data.timeZone.size() > 0
        && data.timeZone.size() <= 64
        && data.timeZone.matches('^[A-Za-z0-9_+\\/-]+$')
        && data.endpoint is string && data.endpoint.size() <= 2048
        && data.endpoint.matches('^https://(fcm\\.googleapis\\.com|android\\.googleapis\\.com|updates\\.push\\.services\\.mozilla\\.com|web\\.push\\.apple\\.com|[a-z0-9-]+\\.notify\\.windows\\.com)/.+$')
        && data.keys is map
        && data.keys.keys().hasOnly(['p256dh','auth'])
        && data.keys.keys().hasAll(['p256dh','auth'])
        && data.keys.p256dh is string
        && data.keys.p256dh.matches('^[A-Za-z0-9_-]{40,200}$')
        && data.keys.auth is string
        && data.keys.auth.matches('^[A-Za-z0-9_-]{10,60}$')
        && data.updatedAt == request.time;
    }
    match /companion_push_devices/{uid}/subscriptions/{deviceId} {
      allow get: if studentOwns(uid);
      allow list: if false;
      allow create, update: if validCompanionPushDevice(uid, deviceId);
      allow delete: if studentOwns(uid);
    }
    // Scheduler-only, accessed exclusively through the Admin SDK.
    match /companion_push_delivery/{uid}/sent/{eventId} {
      allow read, write: if false;
    }

    match /system_health/{document} {
      allow read, write: if false;
    }

  }
}
