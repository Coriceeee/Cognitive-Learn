{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://cognitivelearn.ai.vn" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin/audit", "destination": "/index.html" },
    { "source": "/admin/diagnostics", "destination": "/index.html" },
    { "source": "/student/companion", "destination": "/index.html" },
    { "source": "/student/consent", "destination": "/index.html" },
    { "source": "/student", "destination": "/index.html" },
    { "source": "/student/profile", "destination": "/index.html" },
    { "source": "/student/transcript", "destination": "/index.html" },
    { "source": "/student/storage", "destination": "/index.html" },
    { "source": "/student/modules", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/atlas", "destination": "/index.html" },
    { "source": "/lumen", "destination": "/index.html" },
    { "source": "/orion", "destination": "/index.html" },
    { "source": "/pulse", "destination": "/index.html" },
    { "source": "/haven", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/atlas/study-abroad", "destination": "/index.html" },
    { "source": "/study-abroad", "destination": "/index.html" },
    { "source": "/haven/study-abroad", "destination": "/index.html" },
    { "source": "/atlas/vietnam", "destination": "/index.html" },
    { "source": "/atlas/joint", "destination": "/index.html" },
