# CP73: copy to .env.local on a QA laptop ONLY. Never use real credentials.
# Start `firebase emulators:start --project demo-cla-mvp --config firebase.emulator.cp21.json --only auth,firestore`.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cla-mvp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-cla-mvp
VITE_FIREBASE_STORAGE_BUCKET=demo-cla-mvp.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:cla-mvp-demo
# Never configure GEMINI_API_KEY here: this test uses offline local Firebase only.

# Require explicit product consent during local acceptance testing.
VITE_CLA_STUDENT_CONSENT_GATE=true
