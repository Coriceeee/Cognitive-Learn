# Copy to functions/.env.<YOUR_FIREBASE_PROJECT_ID> AFTER security and privacy review.
# No .env with real keys should be added to a source ZIP.
CLA_PUSH_ENABLED=false
CLA_WEB_PUSH_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY
CLA_WEB_PUSH_CONTACT=mailto:your-technical-contact@example.org
# Private VAPID key must be stored using Firebase Functions Secret Manager:
# firebase functions:secrets:set CLA_WEB_PUSH_VAPID_PRIVATE_KEY
