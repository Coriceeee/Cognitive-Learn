VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# For Vercel serverless functions: configure in Vercel Environment Variables,
# NEVER prefix the private Gemini key with VITE_ and NEVER commit its value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
# Only needed when frontend and API are on distinct origins.
# On one Vercel domain the exact same-origin POST works without this.
CORS_ALLOWED_ORIGINS=
# Optional frontend URL when API is hosted on a separate HTTPS origin.
# VITE_API_BASE_URL=
