VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# For Vercel serverless functions: configure in Vercel Environment Variables,
# NEVER prefix the private Gemini key with VITE_ and NEVER commit its value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
# Only needed when frontend and API are on distinct origins.
# On one Vercel domain the exact same-origin POST works without this.
CORS_ALLOWED_ORIGINS=
# Required when building the Firebase Hosting frontend: use the production Vercel project origin.
# Example: VITE_API_BASE_URL=https://your-cla-api.vercel.app
# Public API origin only, NOT a secret. Never put GEMINI_API_KEY in any VITE_ variable.
VITE_API_BASE_URL=
